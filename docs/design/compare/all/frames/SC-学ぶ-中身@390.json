  "text": "どの 仕事の方にも 出る 章",
  "x": 68,
  "y": 2869,
  "w": 143,
  "h": 14,
  "size": "12px",
  "weight": "700",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "p",
  "text": "声楽・アナウンサー・声優・ポップスの ほか、 の方も、ここを 読みます。",
  "x": 28,
  "y": 2891,
  "w": 334,
  "h": 67,
  "size": "12px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "b",
  "text": "保育士・学校の先生・受付・コールセンター・介護・営業",
  "x": 28,
  "y": 2895,
  "w": 327,
  "h": 36,
  "size": "12px",
  "weight": "700",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "p",
  "text": "ただし 書き方は です。「授業の前は」「シフトの前は」と 言い換えません（9月9日の 裁定②）。",
  "x": 28,
  "y": 2961,
  "w": 334,
  "h": 44,
  "size": "12px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "b",
  "text": "稽古の ことばの まま",
  "x": 120,
  "y": 2965,
  "w": 115,
  "h": 14,
  "size": "12px",
  "weight": "700",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "声帯という器官のこと",
  "x": 29,
  "y": 3027,
  "w": 140,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "声が出るしくみ ― 息・振動・共鳴の三層",
  "x": 29,
  "y": 3064,
  "w": 263,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "逆流性食道炎と声",
  "x": 29,
  "y": 3101,
  "w": 112,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "乾燥と脱水 ― 声帯の粘膜で起きていること",
  "x": 29,
  "y": 3138,
  "w": 277,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "睡眠不足が声に出るまで",
  "x": 29,
  "y": 3175,
  "w": 154,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "風邪・アレルギー・鼻づまりと声",
  "x": 29,
  "y": 3212,
  "w": 209,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "声を削りやすい飲食物と、薬の話",
  "x": 29,
  "y": 3249,
  "w": 210,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "声の調子スコアは何を見ているか",
  "x": 29,
  "y": 3286,
  "w": 210,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "コンディション偏差値 ― なぜ絶対評価にしないのか",
  "x": 29,
  "y": 3323,
  "w": 332,
  "h": 40,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "音名の記録 ― 国際式の表記と、地声で測る理由",
  "x": 29,
  "y": 3380,
  "w": 305,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "CPPS ― 測れること、測れないこと",
  "x": 29,
  "y": 3417,
  "w": 229,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "ウォームアップ効率と音域到達マップ",
  "x": 29,
  "y": 3454,
  "w": 236,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "絶対湿度で環境を見る理由",
  "x": 29,
  "y": 3491,
  "w": 168,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "四つの質問票の使い分け",
  "x": 29,
  "y": 3528,
  "w": 154,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "声の予報は何をしているか",
  "x": 29,
  "y": 3565,
  "w": 167,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "水分の摂り方 ― 何を、いつ",
  "x": 29,
  "y": 3602,
  "w": 179,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "SOVTE ― ストロー発声で声を軽く戻す",
  "x": 29,
  "y": 3639,
  "w": 253,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "声の休息 ― 完全休息と相対休息",
  "x": 29,
  "y": 3676,
  "w": 207,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "加湿と蒸気の吸入",
  "x": 29,
  "y": 3713,
  "w": 112,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "食べることと声 ― エネルギー可用性という見方",
  "x": 29,
  "y": 3750,
  "w": 305,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "本番前日と当日の過ごし方",
  "x": 29,
  "y": 3787,
  "w": 168,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "移動と機内 ― 乾燥への備え",
  "x": 29,
  "y": 3824,
  "w": 179,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "騒がしい場所で声を守る",
  "x": 29,
  "y": 3861,
  "w": 154,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "ウォームダウンという習慣",
  "x": 29,
  "y": 3898,
  "w": 167,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "受診を考える目安",
  "x": 29,
  "y": 3935,
  "w": 112,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "耳鼻咽喉科では何が行われるか",
  "x": 29,
  "y": 3972,
  "w": 196,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "受診用サマリーの使い方",
  "x": 29,
  "y": 4009,
  "w": 154,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "名前を知っておく ― 声帯に起こりうること",
  "x": 29,
  "y": 4046,
  "w": 277,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "薬と声",
  "x": 29,
  "y": 4083,
  "w": 42,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "いつ、耳鼻咽喉科に行くか",
  "x": 29,
  "y": 4120,
  "w": 168,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "歌より、話し声のほうが",
  "x": 29,
  "y": 4157,
  "w": 154,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "用語集",
  "x": 29,
  "y": 4194,
  "w": 42,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "時期を外すと、何をしても届かない",
  "x": 29,
  "y": 4231,
  "w": 223,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "アンケートは、感想を聞く紙ではない",
  "x": 29,
  "y": 4268,
  "w": 238,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "いま聴く人だけを見ていると、未来がなくなる",
  "x": 29,
  "y": 4305,
  "w": 294,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "ブランドは、同じ曲を繰り返すことから始まる",
  "x": 29,
  "y": 4342,
  "w": 294,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "いちばん強い宣伝は「たまたま聴いてしまった」",
  "x": 29,
  "y": 4379,
  "w": 307,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "値段は、あなたではなく土地が決める",
  "x": 29,
  "y": 4416,
  "w": 238,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "プログラムは、演出の一部である",
  "x": 29,
  "y": 4453,
  "w": 209,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "SNSは、名前のない人には効かない",
  "x": 29,
  "y": 4490,
  "w": 224,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "請求書は、あなたの値段を宣言する紙",
  "x": 29,
  "y": 4527,
  "w": 238,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "後援・協賛・助成 ― 3つは別のものです",
  "x": 29,
  "y": 4564,
  "w": 257,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "共演者への支払い ― 仲間を作りながら、資本主義に乗る",
  "x": 29,
  "y": 4601,
  "w": 332,
  "h": 40,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "ホールは、お客さまの生活から逆算して選ぶ",
  "x": 29,
  "y": 4658,
  "w": 279,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "当日の運営は、動線と儀式でできている",
  "x": 29,
  "y": 4695,
  "w": 252,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "span",
  "text": "確定申告と経費 ― 音楽で食べる人のための最低限",
  "x": 29,
  "y": 4732,
  "w": 319,
  "h": 20,
  "size": "14px",
  "weight": "400",
  "color": "rgb(36, 25, 20)"
 },
 {
  "tag": "button",
  "text": "他の職業の記事も見る",
  "x": 16,
  "y": 4778,
  "w": 358,
  "h": 36,
  "size": "14px",
  "weight": "400",
  "color": "rgb(107, 93, 82)"
 },
 {
  "tag": "p",
  "text": "1記事 800〜1,500字。冒頭の 3行で 結論。図は 1枚まで。",
  "x": 16,
  "y": 4839,
  "w": 358,
  "h": 22,
  "size": "12px",
  "weight": "400",
  "color": "rgb(107, 93, 82)"
 },
 {
  "tag": "p",
  "text": "その 仕事の ことばで 書きます（声楽の方に「発話」、アナウンサーの方に「パッサッジョ」と 言いません）。",
  "x": 16,
  "y": 4864,
  "w": 358,
  "h": 44,
  "size": "12px",
  "weight": "400",
  "color": "rgb(107, 93, 82)"
 },
 {
  "tag": "p",
  "text": "「疑い／リスク／早期発見／予防」の 語を 使いません。出典は 記事の 末に 置きます。",
  "x": 16,
  "y": 4911,
  "w": 358,
  "h": 44,
  "size": "12px",
  "weight": "400",
  "color": "rgb(107, 93, 82)"
 },
 {
  "tag": "p",
  "text": "撤回した ACWR の 記事は、ここに ありません。",
  "x": 16,
  "y": 4959,
  "w": 358,
  "h": 22,
  "size": "12px",
  "weight": "400",
  "color": "rgb(107, 93, 82)"
 },
 {
  "tag": "p",
  "text": "読まなくても、アプリは 使えます。",
  "x": 16,
  "y": 4984,
  "w": 358,
  "h": 22,
  "size": "12px",
  "weight": "400",
  "color": "rgb(107, 93, 82)"
