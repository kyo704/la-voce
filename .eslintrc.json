{
  "extends": "next/core-web-vitals",
  "env": { "browser": true, "es2022": true, "node": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "rules": {
    "no-undef": "error"
  },
  "ignorePatterns": [
    "/VocalTracker.jsx",
    "/feedback_route.js",
    "/lib/HealthInfo.jsx",
    "/lib/lib/**",
    "/.next/**",
    "/node_modules/**"
  ]
}
